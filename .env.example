# Copy this file to .env.local for local development, and set the same
# values as Environment Variables in your hosting provider's dashboard
# (e.g. Vercel > Project Settings > Environment Variables) for production.
# Never commit your real .env.local file.

# --- Redis (required for bookings, admin availability, the crowdsourced --
# barcode database, and push subscriptions) -----------------------------
# Connection string for a Redis instance — the Vercel "Official Redis for
# Vercel" storage integration injects this automatically when connected to
# your project (Storage tab > add a Redis database > Connect to Project).
# Any standard redis:// URL works if you'd rather host your own.
#
# Several independent features share this one Redis instance: visit
# bookings and admin availability (src/lib/booking.ts), the crowdsourced
# barcode lookup (src/lib/communityLookup.ts + api/community-lookup) that
# lets one customer's manually-entered barcode auto-fill for every other
# customer who scans the same item afterward, and web push subscriptions
# for reorder-reminder digests (src/lib/pushServer.ts — this also
# auto-generates and persists its own VAPID keypair here, no separate
# env var needed for that).
REDIS_URL=

# --- Admin panel (/admin) ------------------------------------------------
# Plain password for signing into /admin (visit management, availability
# editor). Not hashed — pick something you don't reuse elsewhere.
ADMIN_PASSWORD=

# Where booking-request notifications and admin-password-reset links get
# sent. Also doubles as the one inbox a customer's booking/cancellation
# emails effectively come "from" in spirit (the actual From: header is
# RESEND_FROM_EMAIL below).
OWNER_NOTIFY_EMAIL=

# --- Email (Resend) - required for booking confirmations, cancellation ---
# notices, visit-finished/payment prompts, and admin password reset -------
# Resend account > Settings > API Keys.
RESEND_API_KEY=

# Optional custom "from" address — defaults to Resend's shared test sender,
# which works immediately with no domain setup but has lower deliverability
# and sends "via resend.dev". Verify your own domain in Resend and set this
# once you want mail to come from your own address.
RESEND_FROM_EMAIL=

# --- Stripe (server-only secrets — do NOT prefix with NEXT_PUBLIC_) ------
# Used to create/verify Checkout Sessions for the paid in-person visit
# service (billed after the fact, based on actual time worked — see the
# README's "How the visit-booking + payment flow works"). This account is
# LIVE MODE: every Checkout Session created here is a real, live charge.
#
# Dashboard > Developers > API keys. Use a "restricted key" with only
# Checkout Sessions permissions if you want to minimize blast radius; a
# standard secret key also works.
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Dashboard > Developers > Webhooks > (your endpoint) > Signing secret.
# Required so /api/stripe-webhook can mark a visit "paid" when its
# Checkout Session completes.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Session signing -------------------------------------------------
# Generate with: openssl rand -hex 32
# Signs the legacy subscription-verification cookie (see the README's
# "Legacy: the old subscription flow") and other signed-cookie use.
SESSION_SECRET=

# --- Clyde AI support chat (optional) -----------------------------------
# Ollama Cloud API key. Support chat is free for everyone regardless of
# this variable - if it's unset, or a call to Ollama fails for any reason,
# Clyde quietly falls back to a scripted rule-based assistant instead of
# breaking chat entirely (see src/lib/clyde.ts).
OLLAMA_API_KEY=

# --- Google Sheets sync (optional but recommended) --------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (type: Web application). Add your deployed domain(s) under "Authorized
# JavaScript origins" (e.g. https://weirdsync.com). This value is
# public and safe to ship to the browser.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Google Sheets picker (optional; lets customers browse/pick one of --
# their existing spreadsheets instead of only ever getting an
# app-created one) ------------------------------------------------------
# Google Cloud Console > APIs & Services > Credentials > Create Credentials
# > API key, then APIs & Services > Library > enable "Google Picker API"
# on the same project as the OAuth client above. Also public/safe to ship
# to the browser. Leave blank to skip the picker (sign-in/import still
# work, just against a single app-created sheet).
NEXT_PUBLIC_GOOGLE_API_KEY=

# --- Google Analytics (optional) ---------------------------------------
# Your GA4 "Measurement ID" (Admin > Data Streams > your web stream), looks
# like G-XXXXXXXXXX. Public/safe to ship to the browser like the other
# NEXT_PUBLIC_ vars above. Leave blank to skip Analytics entirely. Even
# when set, the gtag.js script is only ever injected after a customer
# clicks "Accept" on the cookie banner (see GoogleAnalytics.tsx /
# CookieConsentBanner.tsx) — declining, or not answering yet, means it
# never loads.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Barcode product lookup (optional) --------------------------------
# Leave blank to use UPCitemdb's free trial endpoint (rate-limited, no
# key). Set this to your own lookup service's base URL to use a paid
# provider instead; it must accept ?upc=<code> and return { "name": "..." }.
NEXT_PUBLIC_UPC_LOOKUP_URL=

# --- Site URL (optional) -------------------------------------------------
# Base URL used to build links inside booking/status/cancel emails.
# Defaults to https://weirdsync.com if unset.
NEXT_PUBLIC_SITE_URL=

# --- Legacy subscription model (optional) ---------------------------
# Link to Stripe's customer portal, shown as a "Manage billing" link only
# to whatever legacy subscribers remain from the old 4-tier subscription
# model this app used to have. Support chat and the rest of the app don't
# depend on this - see the README's "Legacy: the old subscription flow".
# Dashboard > Settings > Billing > Customer portal.
NEXT_PUBLIC_STRIPE_PORTAL_URL=

# --- Testing tools (optional — leave unset in production) --------------
# The Account tab's "Simulate paid access" panel (see DevAccessToggle.tsx)
# and its /api/dev/toggle-access route already work automatically under
# `npm run dev` — you don't need this variable for that. Only set this to
# "true" if you specifically want the same panel to appear in a
# production-style local build (`next build && next start`). Never set
# this in your actual deployment's environment variables.
NEXT_PUBLIC_ENABLE_TEST_TOOLS=
